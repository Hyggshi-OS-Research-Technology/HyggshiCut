{
  "version": 1,
  "pluginId": "hyggshi_cinematic_pack",
  "name": "Hyggshi Cinematic Color Pack",
  "author": "HyggshiCut Team",
  "version_num": "1.0.0",
  "description": "A collection of cinematic color grading presets and custom video effects. Includes Anime-style, K-Drama warm look, Lo-Fi Aesthetic, Matte Black, and Fuji Film emulation effects.",
